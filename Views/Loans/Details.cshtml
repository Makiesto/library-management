@model LibraryManagement.Models.Loan

@{
    ViewData["Title"] = "Loan Details";
}

<div class="container mt-4">
    <h1>Loan Details</h1>

    <div class="card mt-4">
        <div class="card-header @(Model.IsOverdue && !Model.IsReturned ? "bg-danger text-white" : "bg-info text-white")">
            <h4 class="mb-0">
                @Model.Book.Title
                @if (Model.IsOverdue && !Model.IsReturned)
                {
                    <span class="badge bg-warning text-dark float-end">OVERDUE</span>
                }
                else if (Model.IsReturned)
                {
                    <span class="badge bg-success float-end">RETURNED</span>
                }
                else
                {
                    <span class="badge bg-primary float-end">ACTIVE</span>
                }
            </h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Book</dt>
                <dd class="col-sm-9">
                    <strong>@Model.Book.Title</strong><br>
                    <small class="text-muted">ISBN: @Model.Book.ISBN</small>
                </dd>

                <dt class="col-sm-3">Authors</dt>
                <dd class="col-sm-9">
                    @string.Join(", ", Model.Book.BookAuthors.Select(ba => ba.Author.FullName))
                </dd>

                @if (User.IsInRole("Admin"))
                {
                    <dt class="col-sm-3">Borrower</dt>
                    <dd class="col-sm-9">
                        @Model.User.FullName<br>
                        <small class="text-muted">@Model.User.Email</small>
                    </dd>
                }

                <dt class="col-sm-3">Loan Date</dt>
                <dd class="col-sm-9">@Model.LoanDate.ToString("dd MMMM yyyy")</dd>

                <dt class="col-sm-3">Due Date</dt>
                <dd class="col-sm-9">
                    @Model.DueDate.ToString("dd MMMM yyyy")
                    @if (Model.IsOverdue && !Model.IsReturned)
                    {
                        <br>
                    
                        <span class="text-danger">
                            <strong>Overdue by @((DateTime.Now - Model.DueDate).Days) day(s)</strong>
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">Return Date</dt>
                <dd class="col-sm-9">
                    @if (Model.ReturnDate.HasValue)
                    {
                        @Model.ReturnDate.Value.ToString("dd MMMM yyyy")
                        @if (Model.ReturnDate.Value > Model.DueDate)
                        {
                            <br>
                    
                            <span class="text-warning">
                                Returned @((Model.ReturnDate.Value - Model.DueDate).Days) day(s) late
                            </span>
                        }
                        else
                        {
                            <br>
                    
                            <span class="text-success">Returned on time</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Not returned yet</span>
                    }
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == LibraryManagement.Models.LoanStatus.Active)
                    {
                        <span class="badge bg-primary">Active</span>
                    }
                    else if (Model.Status == LibraryManagement.Models.LoanStatus.Returned)
                    {
                        <span class="badge bg-success">Returned</span>
                    }
                    else if (Model.Status == LibraryManagement.Models.LoanStatus.Overdue)
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">Back to Loans</a>
        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId"
           class="btn btn-info">View Book</a>

        @if (!Model.IsReturned)
        {
            <form asp-action="Return" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Are you sure you want to return this book?')">
                    Return Book
                </button>
            </form>
        }

        @if (User.IsInRole("Admin"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this loan?')">
                    Delete Loan
                </button>
            </form>
        }
    </div>
</div>