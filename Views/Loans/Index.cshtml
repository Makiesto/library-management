@model IEnumerable<LibraryManagement.Models.Loan>

@{
    ViewData["Title"] = "Loans";
    var isAdmin = ViewBag.IsAdmin;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@(isAdmin ? "All Loans" : "My Loans")</h1>
        <a asp-action="Create" class="btn btn-primary">Borrow a Book</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(isAdmin ? "No loans in the system." : "You have no loans yet.")
        </div>
    }
    else
    {
        <!-- Summary cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h5 class="card-title">Active Loans</h5>
                        <h2>@Model.Count(l => l.Status == LibraryManagement.Models.LoanStatus.Active)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-danger">
                    <div class="card-body">
                        <h5 class="card-title">Overdue</h5>
                        <h2>@Model.Count(l => l.Status == LibraryManagement.Models.LoanStatus.Overdue)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h5 class="card-title">Returned</h5>
                        <h2>@Model.Count(l => l.Status == LibraryManagement.Models.LoanStatus.Returned)</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loans table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Book</th>
                        @if (isAdmin)
                        {
                            <th>User</th>
                        }
                        <th>Loan Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr class="@(loan.IsOverdue && !loan.IsReturned ? "table-danger" : "")">
                            <td>
                                <strong>@loan.Book.Title</strong><br>
                                <small class="text-muted">
                                    @string.Join(", ", loan.Book.BookAuthors.Select(ba => ba.Author.FullName))
                                </small>
                            </td>
                            @if (isAdmin)
                            {
                                <td>@loan.User.FullName</td>
                            }
                            <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @loan.DueDate.ToString("dd.MM.yyyy")
                                @if (loan.IsOverdue && !loan.IsReturned)
                                {
                                    <br><span class="badge bg-danger">Overdue!</span>
                                }
                            </td>
                            <td>
                                @if (loan.ReturnDate.HasValue)
                                {
                                    @loan.ReturnDate.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not returned</span>
                                }
                            </td>
                            <td>
                                @if (loan.Status == LibraryManagement.Models.LoanStatus.Active)
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                                else if (loan.Status == LibraryManagement.Models.LoanStatus.Returned)
                                {
                                    <span class="badge bg-success">Returned</span>
                                }
                                else if (loan.Status == LibraryManagement.Models.LoanStatus.Overdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@loan.Id" 
                                       class="btn btn-sm btn-info">Details</a>
                                    
                                    @if (!loan.IsReturned)
                                    {
                                        <form asp-action="Return" asp-route-id="@loan.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    onclick="return confirm('Are you sure you want to return this book?')">
                                                Return
                                            </button>
                                        </form>
                                    }
                                    
                                    @if (isAdmin)
                                    {
                                        <form asp-action="Delete" asp-route-id="@loan.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this loan?')">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted mt-3">
            Total: <strong>@Model.Count()</strong> loan(s)
        </p>
    }
</div>