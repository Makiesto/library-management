@model LibraryManagement.Models.Author

@{
    ViewData["Title"] = "Delete Author";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">Delete Author</h2>
                </div>
                <div class="card-body">
                    <h3 class="text-danger">Are you sure you want to delete this author?</h3>

                    <dl class="row mt-4">
                        <dt class="col-sm-3">Full Name</dt>
                        <dd class="col-sm-9"><strong>@Model.FullName</strong></dd>

                        <dt class="col-sm-3">Birth Date</dt>
                        <dd class="col-sm-9">
                            @if (Model.BirthDate.HasValue)
                            {
                                @Model.BirthDate.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">No data</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Books</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.BookAuthors.Count</span>
                        </dd>
                    </dl>

                    @if (ViewBag.HasBooks)
                    {
                        <div class="alert alert-warning">
                            <strong>Warning!</strong> This author has assigned books.
                            You must remove all book associations before deleting this author.
                        </div>

                        <h5 class="mt-3">Associated Books:</h5>
                        <ul class="list-group mb-3">
                            @foreach (var ba in Model.BookAuthors)
                            {
                                <li class="list-group-item">
                                    @ba.Book.Title (ISBN: @ba.Book.ISBN)
                                </li>
                            }
                        </ul>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary">No, Go Back</a>
                            <button type="submit" class="btn btn-danger"
                                    @(ViewBag.HasBooks ? "disabled" : "")>
                                Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>