@model LibraryManagement.Models.Book

@{
	ViewData["Title"] = "Book Details";
}

<h1>@ViewData["Title"]</h1>

<div>
	<dl class="row">
		<dt class="col-sm-3">ISBN</dt>
		<dd class="col-sm-9">@Model.ISBN</dd>

		<dt class="col-sm-3">Publication Year</dt>
		<dd class="col-sm-9">@Model.PublicationYear</dd>

		<dt class="col-sm-3">Available Copies</dt>
		<dd class="col-sm-9">@Model.AvailableCopies</dd>

		<dt class="col-sm-3">Authors</dt>
		<dd class="col-sm-9">
			@if (Model.BookAuthors != null && Model.BookAuthors.Any())
			{
				<ul class="list-unstyled mb-0">
					@foreach (var ba in Model.BookAuthors)
					{
						<li>@ba.Author.FullName</li>
					}
				</ul>
			}
			else
			{
				<span class="text-muted">No authors</span>
			}
		</dd>

		@if (!string.IsNullOrWhiteSpace(Model.Description))
		{
			<dt class="col-sm-3">Description</dt>
			<dd class="col-sm-9">@Model.Description</dd>
		}
	</dl>
</div>


<div class="mt-4">
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>

	@if (User.Identity?.IsAuthenticated == true && Model.AvailableCopies > 0)
	{
		<a asp-controller="Loans" asp-action="Create" asp-route-bookId="@Model.Id"
		   class="btn btn-success">Borrow Book</a>
	}

	@if (User.IsInRole("Admin"))
	{
		<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
		<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
	}
</div>