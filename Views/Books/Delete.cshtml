@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">Delete Book</h2>
                </div>
                <div class="card-body">
                    <h3 class="text-danger">Are you sure you want to delete this book?</h3>

                    <dl class="row mt-4">
                        <dt class="col-sm-3">Title</dt>
                        <dd class="col-sm-9"><strong>@Model.Title</strong></dd>

                        <dt class="col-sm-3">ISBN</dt>
                        <dd class="col-sm-9">@Model.ISBN</dd>

                        <dt class="col-sm-3">Year</dt>
                        <dd class="col-sm-9">@Model.PublicationYear</dd>

                        <dt class="col-sm-3">Available Copies</dt>
                        <dd class="col-sm-9">@Model.AvailableCopies</dd>

                        <dt class="col-sm-3">Authors</dt>
                        <dd class="col-sm-9">
                            @if (Model.BookAuthors.Any())
                            {
                                @string.Join(", ", Model.BookAuthors.Select(ba => ba.Author.FullName))
                            }
                            else
                            {
                                <span class="text-muted">No authors</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        }
                    </dl>

                    @if (ViewBag.HasActiveLoans)
                    {
                        <div class="alert alert-warning">
                            <strong>Warning!</strong> This book has active loans and cannot be deleted.
                            Please wait until all copies are returned.
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary">No, Go Back</a>
                            <button type="submit" class="btn btn-danger"
                                    @(ViewBag.HasActiveLoans ? "disabled" : "")>
                                Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>