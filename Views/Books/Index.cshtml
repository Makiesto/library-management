@model IEnumerable<LibraryManagement.Models.Book>

    @{
    ViewData["Title"] = "Book List";
    }

    <div class="container mt-4">
        <h1>Book List</h1>

        <form asp-action="Index" method="get" class="mb-4">
            <div class="row">
                <div class="col-md-10">
                    <label for="searchString" class="form-label">Search by Title or ISBN:</label>
                    <input type="text"
                           name="searchString"
                           value="@ViewData["SearchString"]"
                           class="form-control"
                           placeholder="Enter title or ISBN..." />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </form>

        @if (!Model.Any())
    {
        <div class="alert alert-info">
            <strong>No books available in the catalog.</strong>
            @if (User.IsInRole("Admin"))
            {
            <text> <a asp-action="Create">Add the first book</a></text>
            }
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>ISBN</th>
                    <th>Publication Year</th>
                    <th>Available Copies</th>
                    <th>Authors</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                <tr>
                    <td><strong>@book.Title</strong></td>
                    <td>@book.ISBN</td>
                    <td>@book.PublicationYear</td>
                    <td>
                        @if (book.AvailableCopies > 0)
                            {
                        <span class="badge bg-success">@book.AvailableCopies available</span>
                            }
                            else
                            {
                        <span class="badge bg-danger">Unavailable</span>
                            }
                    </td>
                    <td>
                        @if (book.BookAuthors != null && book.BookAuthors.Any())
                            {
                                @: @string.Join(", ", book.BookAuthors.Select(ba => ba.Author.FullName));
                            }
                            else
                            {
                        <span class="text-muted">No authors</span>
                            }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">
                                Details
                            </a>
                            @if (User.IsInRole("Admin"))
                                {
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">
                                Delete
                            </a>
                                }
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <p class="text-muted">
                Found: <strong>@Model.Count()</strong>
                @(Model.Count() == 1 ? "book" : "books")
            </p>
        </div>
    }

        @if (User.IsInRole("Admin"))
    {
        <div class="mt-4">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Book
            </a>
        </div>
    }
    </div>
